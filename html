<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ШАУРМА · Вкус Востока</title>
<meta name="description" content="Лучшая шаурма в городе — свежие продукты, открытый огонь, восточные специи. Готовим за 5 минут.">
<meta property="og:title" content="ШАУРМА · Вкус Востока">
<meta property="og:description" content="Свежие продукты, открытый огонь, восточные специи.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;800&family=Unbounded:wght@400;600;800;900&display=swap" rel="stylesheet">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌯</text></svg>">
<style>
/* ============ БАЗА ============ */
:root{
  --bg:#0d0705;
  --orange:#ff7a18;
  --red:#ff3d00;
  --yellow:#ffb703;
  --cream:#fff4e6;
  --muted:#b39b8a;
  --border:rgba(255,255,255,.09);
  --card:rgba(255,255,255,.04);
  --radius:24px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:'Manrope',system-ui,-apple-system,sans-serif;
  background:var(--bg);
  color:var(--cream);
  overflow-x:hidden;
  line-height:1.65;
  -webkit-font-smoothing:antialiased;
}
body::before{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background:
    radial-gradient(900px 620px at 12% -8%, rgba(255,122,24,.20), transparent 62%),
    radial-gradient(820px 620px at 92% 6%, rgba(255,61,0,.16), transparent 62%),
    radial-gradient(1000px 800px at 50% 112%, rgba(255,183,3,.10), transparent 62%);
}
::selection{background:rgba(255,122,24,.35);color:#fff}
img,svg{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font-family:inherit}

.container{max-width:1200px;margin:0 auto;padding:0 24px;position:relative;z-index:1}

/* ============ КУРСОР-СВЕЧЕНИЕ ============ */
.cursor-glow{
  position:fixed;left:0;top:0;width:520px;height:520px;border-radius:50%;
  background:radial-gradient(circle, rgba(255,122,24,.13), transparent 62%);
  pointer-events:none;z-index:2;will-change:transform;
  transition:opacity .4s;
}
@media (hover:none){.cursor-glow{display:none}}

/* ============ ХЕДЕР ============ */
header{
  position:fixed;top:0;left:0;right:0;z-index:100;
  padding:20px 0;transition:padding .35s, background .35s, border-color .35s;
  border-bottom:1px solid transparent;
}
header.scrolled{
  padding:12px 0;
  background:rgba(13,7,5,.72);
  backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
  border-bottom-color:var(--border);
}
.nav{display:flex;align-items:center;justify-content:space-between;gap:20px}
.logo{display:flex;align-items:center;gap:12px;font-family:'Unbounded',sans-serif;font-weight:800;font-size:19px;letter-spacing:-.5px}
.logo-mark{
  width:42px;height:42px;border-radius:14px;display:grid;place-items:center;
  background:linear-gradient(135deg,#ff8a00,#ff3d00);
  font-family:'Unbounded',sans-serif;font-weight:900;font-size:19px;color:#fff;
  box-shadow:0 8px 26px -8px rgba(255,90,0,.9);
  transform:rotate(-6deg);transition:transform .4s;
}
.logo:hover .logo-mark{transform:rotate(6deg) scale(1.06)}
.logo span{color:var(--orange)}

.nav-links{display:flex;align-items:center;gap:34px}
.nav-links a{
  position:relative;font-size:14.5px;font-weight:600;color:var(--muted);
  transition:color .3s;
}
.nav-links a::after{
  content:'';position:absolute;left:0;bottom:-6px;height:2px;width:0;border-radius:2px;
  background:linear-gradient(90deg,var(--yellow),var(--red));transition:width .35s cubic-bezier(.2,.8,.2,1);
}
.nav-links a:hover{color:var(--cream)}
.nav-links a:hover::after{width:100%}

.nav-cta{
  padding:12px 24px;border-radius:999px;font-weight:800;font-size:14px;
  background:linear-gradient(100deg,#ff8a00,#ff3d00);color:#fff;
  box-shadow:0 10px 30px -10px rgba(255,90,0,.9);
  transition:transform .3s, box-shadow .3s;white-space:nowrap;
}
.nav-cta:hover{transform:translateY(-2px);box-shadow:0 16px 40px -10px rgba(255,90,0,1)}

.burger{display:none;flex-direction:column;gap:5px;background:none;border:0;cursor:pointer;padding:8px}
.burger span{width:24px;height:2px;background:var(--cream);border-radius:2px;transition:.3s}
.burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

.mobile-menu{
  position:fixed;top:0;right:0;height:100vh;width:min(320px,80vw);z-index:99;
  background:rgba(16,9,6,.96);backdrop-filter:blur(24px);
  border-left:1px solid var(--border);
  padding:110px 32px 40px;display:flex;flex-direction:column;gap:8px;
  transform:translateX(100%);transition:transform .45s cubic-bezier(.2,.8,.2,1);
}
.mobile-menu.open{transform:translateX(0)}
.mobile-menu a{padding:16px 0;font-size:18px;font-weight:600;border-bottom:1px solid var(--border);color:var(--cream)}
.mobile-menu .nav-cta{margin-top:24px;text-align:center}

/* ============ HERO ============ */
.hero{position:relative;min-height:100svh;display:flex;align-items:center;padding:150px 0 90px;z-index:1}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:50px;align-items:center}

.badge{
  display:inline-flex;align-items:center;gap:9px;
  padding:9px 18px;border-radius:999px;font-size:13px;font-weight:700;
  background:rgba(255,122,24,.10);border:1px solid rgba(255,122,24,.30);
  color:#ffc98a;margin-bottom:28px;letter-spacing:.3px;
}
.badge .dot{width:7px;height:7px;border-radius:50%;background:#2ecc71;box-shadow:0 0 0 0 rgba(46,204,113,.6);animation:live 2s infinite}
@keyframes live{70%{box-shadow:0 0 0 9px rgba(46,204,113,0)}100%{box-shadow:0 0 0 0 rgba(46,204,113,0)}}

.hero h1{
  font-family:'Unbounded',sans-serif;font-weight:900;
  font-size:clamp(38px,5.6vw,74px);line-height:.98;letter-spacing:-2.5px;
  margin-bottom:26px;
}
.grad{
  background:linear-gradient(100deg,#ffb703 0%,#ff7a18 42%,#ff3d00 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero p.lead{font-size:17.5px;color:var(--muted);max-width:480px;margin-bottom:38px;font-weight:400}
.hero-actions{display:flex;gap:14px;flex-wrap:wrap}

.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;
  padding:17px 32px;border-radius:999px;font-weight:800;font-size:15px;
  border:none;cursor:pointer;transition:transform .3s cubic-bezier(.2,.8,.2,1), box-shadow .3s, background .3s;
}
.btn-primary{
  background:linear-gradient(100deg,#ff8a00,#ff3d00);color:#fff;
  box-shadow:0 14px 44px -12px rgba(255,90,0,.95);
}
.btn-primary:hover{transform:translateY(-4px);box-shadow:0 22px 60px -12px rgba(255,90,0,1)}
.btn-ghost{
  background:rgba(255,255,255,.04);border:1px solid var(--border);color:var(--cream);
  backdrop-filter:blur(10px);
}
.btn-ghost:hover{background:rgba(255,255,255,.09);transform:translateY(-4px)}

/* Визуал шаурмы */
.hero-visual{position:relative;display:flex;justify-content:center;align-items:center}
.hero-visual::before{
  content:'';position:absolute;width:min(560px,100%);aspect-ratio:1;border-radius:50%;
  background:radial-gradient(circle, rgba(255,122,24,.42), transparent 66%);
  filter:blur(46px);animation:pulse 5s ease-in-out infinite;
}
@keyframes pulse{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(1.10);opacity:1}}

.shawarma{
  position:relative;width:min(400px,88%);z-index:2;
  filter:drop-shadow(0 40px 60px rgba(0,0,0,.7));
  animation:float 6s ease-in-out infinite;
}
@keyframes float{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-22px) rotate(2deg)}}

.spark{
  position:absolute;font-size:22px;z-index:3;animation:sparkle 3.6s ease-in-out infinite;
  filter:drop-shadow(0 0 14px rgba(255,183,3,.9));
}
.spark:nth-child(1){top:10%;left:6%;animation-delay:0s}
.spark:nth-child(2){top:24%;right:4%;animation-delay:.9s}
.spark:nth-child(3){bottom:20%;left:2%;animation-delay:1.8s}
.spark:nth-child(4){bottom:12%;right:10%;animation-delay:2.6s}
@keyframes sparkle{0%,100%{transform:scale(.7) rotate(0);opacity:.4}50%{transform:scale(1.25) rotate(20deg);opacity:1}}

/* ============ БЕГУЩАЯ СТРОКА ============ */
.marquee{
  position:relative;z-index:1;overflow:hidden;white-space:nowrap;
  padding:22px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);
  background:linear-gradient(90deg, rgba(255,122,24,.06), rgba(255,61,0,.06));
  mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);
}
.marquee-track{display:inline-flex;gap:0;animation:scrollX 30s linear infinite;will-change:transform}
.marquee-track span{
  font-family:'Unbounded',sans-serif;font-weight:800;font-size:17px;letter-spacing:2px;
  padding:0 30px;color:transparent;
  background:linear-gradient(100deg,#ffb703,#ff7a18,#ff3d00);
  -webkit-background-clip:text;background-clip:text;
}
@keyframes scrollX{to{transform:translateX(-50%)}}

/* ============ СЕКЦИИ ============ */
section{position:relative;z-index:1}
.section{padding:110px 0}
.section-head{text-align:center;max-width:640px;margin:0 auto 64px}
.eyebrow{
  display:inline-block;font-size:13px;font-weight:800;letter-spacing:3px;text-transform:uppercase;
  color:var(--orange);margin-bottom:18px;
}
.section-head h2{
  font-family:'Unbounded',sans-serif;font-weight:800;
  font-size:clamp(30px,4.2vw,50px);line-height:1.06;letter-spacing:-1.6px;margin-bottom:18px;
}
.section-head p{color:var(--muted);font-size:16.5px}

/* ============ СТАТИСТИКА ============ */
.stats{padding:0 0 110px}
.stats-grid{
  display:grid;grid-template-columns:repeat(4,1fr);gap:1px;
  background:var(--border);border:1px solid var(--border);border-radius:var(--radius);
  overflow:hidden;
}
.stat{
  background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.01));
  padding:40px 24px;text-align:center;transition:background .4s;
}
.stat:hover{background:rgba(255,122,24,.09)}
.stat-num{
  font-family:'Unbounded',sans-serif;font-weight:900;font-size:clamp(30px,4vw,44px);
  letter-spacing:-2px;line-height:1;
  background:linear-gradient(100deg,#ffb703,#ff3d00);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  margin-bottom:10px;
}
.stat-label{font-size:13.5px;color:var(--muted);font-weight:600}

/* ============ МЕНЮ ============ */
.menu-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.card{
  position:relative;border-radius:var(--radius);padding:32px 28px 30px;overflow:hidden;
  background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.015));
  border:1px solid var(--border);
  transition:transform .45s cubic-bezier(.2,.8,.2,1), border-color .4s, box-shadow .45s;
}
.card::before{
  content:'';position:absolute;inset:-1px;border-radius:inherit;padding:1px;opacity:0;
  background:linear-gradient(140deg,rgba(255,183,3,.9),rgba(255,61,0,.9),transparent 70%);
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  transition:opacity .45s;pointer-events:none;
}
.card:hover{transform:translateY(-10px);box-shadow:0 36px 70px -28px rgba(255,90,0,.55)}
.card:hover::before{opacity:1}
.card:hover .card-icon{transform:scale(1.12) rotate(-8deg)}
.card-icon{
  width:70px;height:70px;border-radius:20px;display:grid;place-items:center;
  font-size:34px;margin-bottom:22px;
  background:linear-gradient(145deg,rgba(255,122,24,.22),rgba(255,61,0,.08));
  border:1px solid rgba(255,122,24,.24);
  transition:transform .45s cubic-bezier(.2,.8,.2,1);
}
.card h3{font-family:'Unbounded',sans-serif;font-weight:700;font-size:19px;letter-spacing:-.5px;margin-bottom:9px}
.card p{color:var(--muted);font-size:14.5px;margin-bottom:22px;min-height:44px}
.card-foot{display:flex;align-items:center;justify-content:space-between;gap:12px}
.price{
  font-family:'Unbounded',sans-serif;font-weight:800;font-size:22px;letter-spacing:-1px;
  background:linear-gradient(100deg,#ffb703,#ff3d00);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.tag{
  font-size:11px;font-weight:800;letter-spacing:1px;text-transform:uppercase;
  padding:6px 12px;border-radius:999px;
  background:rgba(255,61,0,.14);color:#ff8f6b;border:1px solid rgba(255,61,0,.28);
}
.tag.hit{background:rgba(46,204,113,.14);color:#6ee7a8;border-color:rgba(46,204,113,.3)}

/* ============ ШАГИ ============ */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;position:relative}
.step{
  position:relative;padding:38px 30px;border-radius:var(--radius);
  background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.012));
  border:1px solid var(--border);transition:.4s;
}
.step:hover{border-color:rgba(255,122,24,.4);transform:translateY(-6px)}
.step-num{
  font-family:'Unbounded',sans-serif;font-weight:900;font-size:62px;line-height:1;
  letter-spacing:-4px;color:transparent;-webkit-text-stroke:1.5px rgba(255,122,24,.42);
  margin-bottom:16px;
}
.step h3{font-family:'Unbounded',sans-serif;font-size:18px;font-weight:700;margin-bottom:10px;letter-spacing:-.4px}
.step p{color:var(--muted);font-size:14.5px}

/* ============ ОТЗЫВЫ ============ */
.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.review{
  padding:32px 28px;border-radius:var(--radius);
  background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.012));
  border:1px solid var(--border);transition:.4s;
}
.review:hover{transform:translateY(-6px);border-color:rgba(255,183,3,.35)}
.stars{color:#ffb703;font-size:15px;letter-spacing:3px;margin-bottom:16px}
.review p{font-size:15px;color:#e8d9cc;margin-bottom:22px}
.reviewer{display:flex;align-items:center;gap:13px}
.avatar{
  width:44px;height:44px;border-radius:50%;display:grid;place-items:center;
  font-family:'Unbounded',sans-serif;font-weight:800;font-size:16px;color:#fff;
  background:linear-gradient(140deg,#ff8a00,#ff3d00);
}
.reviewer b{display:block;font-size:14.5px;font-weight:800}
.reviewer small{color:var(--muted);font-size:12.5px}

/* ============ CTA / ФОРМА ============ */
.cta-box{
  position:relative;border-radius:32px;padding:66px 52px;overflow:hidden;
  background:linear-gradient(150deg,rgba(255,122,24,.16),rgba(255,61,0,.07) 55%,rgba(255,183,3,.10));
  border:1px solid rgba(255,122,24,.26);
  display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center;
}
.cta-box::after{
  content:'';position:absolute;width:460px;height:460px;border-radius:50%;
  right:-140px;top:-160px;pointer-events:none;
  background:radial-gradient(circle,rgba(255,122,24,.32),transparent 66%);
  filter:blur(30px);
}
.cta-box h2{
  font-family:'Unbounded',sans-serif;font-weight:800;
  font-size:clamp(28px,3.6vw,44px);line-height:1.06;letter-spacing:-1.6px;margin-bottom:18px;
}
.cta-box p{color:var(--muted);font-size:16px;max-width:400px}
form{display:flex;flex-direction:column;gap:14px;position:relative;z-index:1}
.field{display:flex;flex-direction:column;gap:8px}
.field label{font-size:12.5px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted)}
.field input,.field select{
  width:100%;padding:16px 20px;border-radius:16px;font-size:15px;font-family:inherit;
  background:rgba(0,0,0,.32);border:1px solid var(--border);color:var(--cream);
  outline:none;transition:border-color .3s, background .3s;
}
.field input::placeholder{color:#7d6a5c}
.field input:focus,.field select:focus{border-color:rgba(255,122,24,.65);background:rgba(0,0,0,.48)}
.field select option{background:#1a0f0a;color:var(--cream)}
form .btn-primary{width:100%;margin-top:6px}
.form-note{font-size:12.5px;color:#7d6a5c;text-align:center}
.form-success{
  display:none;padding:16px;border-radius:14px;text-align:center;font-weight:700;font-size:14.5px;
  background:rgba(46,204,113,.14);border:1px solid rgba(46,204,113,.35);color:#6ee7a8;
}
.form-success.show{display:block;animation:fadeUp .5s}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

/* ============ ФУТЕР ============ */
footer{
  position:relative;z-index:1;margin-top:110px;padding:60px 0 40px;
  border-top:1px solid var(--border);background:rgba(0,0,0,.28);
}
.foot-grid{display:flex;justify-content:space-between;align-items:flex-start;gap:40px;flex-wrap:wrap;margin-bottom:44px}
.foot-brand{max-width:300px}
.foot-brand p{color:var(--muted);font-size:14px;margin-top:16px}
.foot-col h4{
  font-family:'Unbounded',sans-serif;font-size:13px;font-weight:700;letter-spacing:1.6px;
  text-transform:uppercase;color:var(--cream);margin-bottom:16px;
}
.foot-col a{display:block;color:var(--muted);font-size:14.5px;margin-bottom:11px;transition:color .3s,transform .3s}
.foot-col a:hover{color:var(--orange);transform:translateX(4px)}
.foot-bottom{
  display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;
  padding-top:28px;border-top:1px solid var(--border);color:#7d6a5c;font-size:13.5px;
}
.socials{display:flex;gap:10px}
.socials a{
  width:40px;height:40px;border-radius:12px;display:grid;place-items:center;
  background:rgba(255,255,255,.05);border:1px solid var(--border);font-size:16px;
  transition:.3s;
}
.socials a:hover{background:rgba(255,122,24,.18);border-color:rgba(255,122,24,.45);transform:translateY(-3px)}

/* ============ АНИМАЦИЯ ПОЯВЛЕНИЯ ============ */
.reveal{opacity:0;transform:translateY(34px);transition:opacity .85s cubic-bezier(.2,.8,.2,1), transform .85s cubic-bezier(.2,.8,.2,1)}
.reveal.in{opacity:1;transform:none}

/* ============ АДАПТИВ ============ */
@media(max-width:1024px){
  .menu-grid{grid-template-columns:repeat(2,1fr)}
  .hero-grid{grid-template-columns:1fr;gap:56px;text-align:center}
  .hero p.lead{margin-inline:auto}
  .hero-actions{justify-content:center}
  .cta-box{grid-template-columns:1fr;padding:52px 34px;gap:36px}
  .stats-grid{grid-template-columns:repeat(2,1fr)}
  .steps,.reviews{grid-template-columns:1fr}
}
@media(max-width:768px){
  .nav-links{display:none}
  .nav-cta{display:none}
  .burger{display:flex}
  .section{padding:76px 0}
  .menu-grid{grid-template-columns:1fr}
  .stats{padding-bottom:76px}
  .hero{padding-top:126px}
  footer{margin-top:76px}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
  html{scroll-behavior:auto}
}
</style>
</head>
<body>

<div class="cursor-glow" id="glow"></div>

<!-- ================= ХЕДЕР ================= -->
<header id="header">
  <div class="container nav">
    <a href="#" class="logo"><div class="logo-mark">Ш</div>ШАУРМА<span>.</span></a>
    <nav class="nav-links">
      <a href="#menu">Меню</a>
      <a href="#how">Как готовим</a>
      <a href="#reviews">Отзывы</a>
      <a href="#order">Контакты</a>
    </nav>
    <a href="#order" class="nav-cta">Заказать 🔥</a>
    <button class="burger" id="burger" aria-label="Открыть меню">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu">
  <a href="#menu">Меню</a>
  <a href="#how">Как готовим</a>
  <a href="#reviews">Отзывы</a>
  <a href="#order">Контакты</a>
  <a href="#order" class="nav-cta">Заказать 🔥</a>
</div>

<!-- ================= HERO ================= -->
<section class="hero">
